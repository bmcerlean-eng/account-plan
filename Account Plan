<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Enterprise Account Plan</title>
  <style>
    :root {
      --bg: #f3f5f9;
      --surface: #ffffff;
      --border: #dbe2ef;
      --text: #1f2a44;
      --muted: #667085;
      --primary: #2854d6;
      --primary-soft: #e8eeff;
      --success: #0f9d58;
      --warning: #c97a00;
      --danger: #c62828;
      --radius: 14px;
      --shadow: 0 10px 22px rgba(16, 24, 40, 0.08);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: Inter, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      line-height: 1.5;
    }

    .page {
      max-width: 1200px;
      margin: 0 auto;
      padding: 24px;
      display: grid;
      gap: 18px;
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 18px;
    }

    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }

    .title {
      margin: 0;
      font-size: 1.55rem;
      font-weight: 700;
    }

    .subtitle {
      margin: 2px 0 0;
      color: var(--muted);
      font-size: 0.95rem;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border-radius: 999px;
      background: #ecfdf3;
      color: var(--success);
      border: 1px solid #b7ebce;
      padding: 6px 10px;
      font-size: 0.85rem;
      font-weight: 600;
    }

    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--success);
    }

    .button-group {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    button {
      border-radius: 10px;
      border: 1px solid var(--border);
      padding: 9px 13px;
      font-weight: 600;
      cursor: pointer;
      background: #fff;
      color: var(--text);
    }

    .primary {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary);
    }

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(140px, 1fr));
      gap: 12px;
    }

    .summary-item {
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px;
      background: linear-gradient(180deg, #fff 0%, #fafcff 100%);
    }

    .summary-label {
      margin: 0;
      font-size: 0.8rem;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .summary-value {
      margin: 8px 0 0;
      font-size: 1.2rem;
      font-weight: 700;
    }

    .section-grid {
      display: grid;
      grid-template-columns: 1.25fr 1fr;
      gap: 14px;
    }

    .section-title {
      margin: 0 0 12px;
      font-size: 1.08rem;
      font-weight: 700;
    }

    .plan-banner {
      background: var(--primary-soft);
      border: 1px solid #c7d6ff;
      border-radius: 12px;
      padding: 14px;
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: center;
      flex-wrap: wrap;
    }

    .plan-name {
      font-size: 1.06rem;
      margin: 0;
      font-weight: 700;
    }

    .plan-price {
      margin: 4px 0 0;
      color: #2f3f66;
      font-size: 0.95rem;
    }

    .list {
      margin: 14px 0 0;
      padding-left: 18px;
      display: grid;
      gap: 8px;
      color: #2d3c5a;
    }

    .kv {
      display: grid;
      gap: 10px;
    }

    .kv-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      border-bottom: 1px dashed var(--border);
      padding-bottom: 9px;
    }

    .kv-label {
      color: var(--muted);
      font-size: 0.92rem;
    }

    .kv-value {
      font-weight: 600;
      text-align: right;
    }

    .usage-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(150px, 1fr));
      gap: 12px;
    }

    .meter {
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px;
      background: #fcfdff;
    }

    .meter h4 {
      margin: 0;
      font-size: 0.92rem;
    }

    .meter p {
      margin: 5px 0 10px;
      color: var(--muted);
      font-size: 0.85rem;
    }

    .track {
      width: 100%;
      height: 8px;
      border-radius: 999px;
      background: #e7ecf5;
      overflow: hidden;
    }

    .fill {
      height: 100%;
      border-radius: 999px;
      background: linear-gradient(90deg, #4f7bff 0%, #2854d6 100%);
      width: 0;
      transition: width 400ms ease;
    }

    .fill.warning {
      background: linear-gradient(90deg, #ffcb66 0%, #f3a41f 100%);
    }

    .fill.danger {
      background: linear-gradient(90deg, #f28e8e 0%, #d64646 100%);
    }

    .table-wrap {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 580px;
    }

    th,
    td {
      text-align: left;
      padding: 10px 8px;
      border-bottom: 1px solid var(--border);
      font-size: 0.93rem;
    }

    th {
      color: var(--muted);
      font-weight: 600;
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .tag {
      display: inline-block;
      border-radius: 999px;
      padding: 4px 8px;
      font-size: 0.8rem;
      font-weight: 600;
      border: 1px solid transparent;
    }

    .tag.active {
      background: #ecfdf3;
      border-color: #b7ebce;
      color: var(--success);
    }

    .tag.pending {
      background: #fff9eb;
      border-color: #f7dc9c;
      color: var(--warning);
    }

    @media (max-width: 980px) {
      .summary-grid {
        grid-template-columns: repeat(2, minmax(140px, 1fr));
      }

      .section-grid {
        grid-template-columns: 1fr;
      }

      .usage-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 560px) {
      .page {
        padding: 16px;
      }

      .summary-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <main class="page" aria-label="Enterprise account plan page">
    <section class="card topbar">
      <div>
        <h1 class="title">Northstar Financial Group</h1>
        <p class="subtitle">Enterprise account plan and subscription overview</p>
      </div>
      <div class="button-group">
        <span class="pill"><span class="dot" aria-hidden="true"></span> Active contract</span>
        <button type="button">Download contract</button>
        <button type="button" class="primary">Manage add-ons</button>
      </div>
    </section>

    <section class="card summary-grid" aria-label="Plan summary">
      <article class="summary-item">
        <p class="summary-label">Plan tier</p>
        <p class="summary-value">Enterprise Plus</p>
      </article>
      <article class="summary-item">
        <p class="summary-label">Billing cycle</p>
        <p class="summary-value">Annual</p>
      </article>
      <article class="summary-item">
        <p class="summary-label">Renewal date</p>
        <p class="summary-value">Aug 15, 2026</p>
      </article>
      <article class="summary-item">
        <p class="summary-label">Current spend</p>
        <p class="summary-value">$84,000 / year</p>
      </article>
    </section>

    <div class="section-grid">
      <section class="card" aria-label="Plan details">
        <h2 class="section-title">Plan details</h2>
        <div class="plan-banner">
          <div>
            <p class="plan-name">Enterprise Plus</p>
            <p class="plan-price">$7,000 monthly equivalent · 200 seats included</p>
          </div>
          <button type="button" class="primary">Request upgrade</button>
        </div>
        <ul class="list">
          <li>Unlimited projects, environments, and API calls</li>
          <li>SAML SSO with SCIM user provisioning</li>
          <li>Dedicated account manager and SLA-backed support</li>
          <li>Advanced analytics and audit log retention (5 years)</li>
          <li>Custom security controls and private networking</li>
        </ul>
      </section>

      <section class="card" aria-label="Billing and contacts">
        <h2 class="section-title">Billing and contacts</h2>
        <div class="kv">
          <div class="kv-row">
            <span class="kv-label">Primary billing contact</span>
            <span class="kv-value">maya.chen@northstar.com</span>
          </div>
          <div class="kv-row">
            <span class="kv-label">Payment method</span>
            <span class="kv-value">Invoice - Net 45</span>
          </div>
          <div class="kv-row">
            <span class="kv-label">Last invoice</span>
            <span class="kv-value">INV-2026-0017 ($7,000)</span>
          </div>
          <div class="kv-row">
            <span class="kv-label">Next invoice date</span>
            <span class="kv-value">Mar 01, 2026</span>
          </div>
          <div class="kv-row">
            <span class="kv-label">Contract ID</span>
            <span class="kv-value">ENT-NFG-2025-08</span>
          </div>
        </div>
      </section>
    </div>

    <section class="card" aria-label="Usage metrics">
      <h2 class="section-title">Current usage</h2>
      <div class="usage-grid">
        <article class="meter" data-used="164" data-total="200">
          <h4>Seats in use</h4>
          <p>164 of 200 seats assigned</p>
          <div class="track" role="img" aria-label="82 percent seats used">
            <div class="fill"></div>
          </div>
        </article>
        <article class="meter" data-used="18.2" data-total="25">
          <h4>Storage usage</h4>
          <p>18.2 TB of 25 TB consumed</p>
          <div class="track" role="img" aria-label="73 percent storage used">
            <div class="fill warning"></div>
          </div>
        </article>
        <article class="meter" data-used="8600000" data-total="10000000">
          <h4>API requests</h4>
          <p>8.6M of 10M requests this month</p>
          <div class="track" role="img" aria-label="86 percent api requests used">
            <div class="fill danger"></div>
          </div>
        </article>
      </div>
    </section>

    <section class="card table-wrap" aria-label="Department allocation">
      <h2 class="section-title">Seat allocation by department</h2>
      <table>
        <thead>
          <tr>
            <th>Department</th>
            <th>Allocated seats</th>
            <th>Used seats</th>
            <th>Manager</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Engineering</td>
            <td>90</td>
            <td>82</td>
            <td>Arjun Patel</td>
            <td><span class="tag active">Healthy</span></td>
          </tr>
          <tr>
            <td>Operations</td>
            <td>45</td>
            <td>41</td>
            <td>Rosa Alvarez</td>
            <td><span class="tag pending">Near limit</span></td>
          </tr>
          <tr>
            <td>Data & Analytics</td>
            <td>35</td>
            <td>29</td>
            <td>Jonas Meyer</td>
            <td><span class="tag active">Healthy</span></td>
          </tr>
          <tr>
            <td>Security</td>
            <td>30</td>
            <td>12</td>
            <td>Natalia Baez</td>
            <td><span class="tag active">Healthy</span></td>
          </tr>
        </tbody>
      </table>
    </section>
  </main>

  <script>
    (function renderMeters() {
      var meters = document.querySelectorAll(".meter");
      meters.forEach(function (meter) {
        var used = Number(meter.getAttribute("data-used"));
        var total = Number(meter.getAttribute("data-total"));
        var fill = meter.querySelector(".fill");
        if (!fill || !total) return;
        var percent = Math.max(0, Math.min(100, (used / total) * 100));
        fill.style.width = percent + "%";
      });
    })();
  </script>
</body>
</html>
